{
  "name": "praxis-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web UI for Praxis — a Bun + Claude Agent SDK tunnel to the live coach.",
  "scripts": {
    "test": "bun test server/",
    "app": "bun run server/index.ts",
    "dev:server": "bun --watch run server/index.ts",
    "dev:web": "vite web --port 4601",
    "build:web": "vite build web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "mammoth": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
